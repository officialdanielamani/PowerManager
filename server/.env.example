# Copy to .env and edit. All values are optional.

# Secret used to sign login cookies. If empty, one is generated and saved in instance/secret_key.
SECRET_KEY=

# If set, the first-run setup page asks for this token (protects an internet-exposed server
# before the admin account exists). If empty, a random token is generated and printed in the log.
# Set to "off" to disable the check (LAN only).
SETUP_TOKEN=

# Number of threads (each connected meter uses one thread). Default 100.
GUNICORN_THREADS=100
